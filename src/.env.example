# This file is an example of environment variables for the mini-rag application.
# Copy this file to .env and fill in the required values.

# Environment variables for the mini-rag application
APP_NAME="mini-rag"
APP_VERSION="0.1"
OPENAI_API_KEY=""

# Database configuration
FILE_ALLOWED_TYPES=
FILE_MAX_SIZE=
FILE_DEFAULT_CHUNK_SIZE=512000 # 512 KB

# MongoDB configuration
MONGODB_URL= 
MONGODB_DATABASE=


# ====================== LLM Config =================

GENERATION_BACKEND = "OPENAI"
EMBEDDING_BACKEND = "COHERE"

OPENAI_API_KEY = ""
OPENAI_API_URL = 
COHERE_API_KEY = ""

GENERATION_MODEL_ID = "gpt-3.5-turbo-0125"
EMBEDDING_MODEL_ID = "embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE = 384

INPUT_DEFAULT_MAX_CHARACTERS = 1024
GENERATION_DEFAULT_MAX_TOKENS = 200
GENERATION_DEFAULT_TEMPERATURE = 0.1

# ====================== Vector DB Config =================

VECTOR_DB_BACKEND = "QDRANT"
VECTOR_DB_PATH = "qdrant_db"
VECTOR_DB_DISTANCE_METHOD = "Cosine"
